"""

static var _area_rows := PackedStringArray()


## Khu của ô (x, y): chỉ số trong AREAS, -1 = không thuộc khu nào (ngoài thế giới, đấu trường...).
static func area_index(x: int, y: int) -> int:
	if _area_rows.is_empty():
		_area_rows = AREA_MAP.strip_edges().split("\n")
	if y < 0 or y >= _area_rows.size() or x < 0 or x >= _area_rows[y].length():
		return -1
	return AREA_KEYS.find(_area_rows[y][x])


## Ghép bản đồ cũ (core_rows, các hàng của MAP trong scripts/level.gd) vào giữa thế giới.
static func compose(core_rows: PackedStringArray) -> PackedStringArray:
	var lines := MAP.split("\n")
	var out := PackedStringArray()
	for line in lines:
		var row := line.strip_edges(false, true)
		if row.is_empty() and out.is_empty():
			continue
		out.append(row)
	while out.size() > SIZE.y:
		out.remove_at(out.size() - 1)
	for i in core_rows.size():
		var y := CORE.position.y + i
		if y >= out.size():
			break
		var core_row: String = core_rows[i].rpad(CORE.size.x, "T").substr(0, CORE.size.x)
		var row: String = out[y].rpad(SIZE.x, "~")
		out[y] = row.substr(0, CORE.position.x) + core_row + row.substr(CORE.end.x)
	return out
